{
  "name": "@opt2-tealbrick/ui",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Teal Brick design system: tokens + React components (teal + burgundy, uniform 2px radius, no dots, no green or orange).",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css src/components.css dist/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --run build && node --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
