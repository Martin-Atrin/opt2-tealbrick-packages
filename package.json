{
  "name": "opt2-tealbrick-packages",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/ui/tsconfig.json",
    "lint": "biome check .",
    "build": "tsc -p packages/ui/tsconfig.build.json && cp packages/ui/src/tokens.css packages/ui/src/components.css packages/ui/dist/",
    "test": "node --run build && node --test packages/ui/test/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
